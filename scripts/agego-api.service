[Unit]
Description=AgeGo API
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/agego/api
Environment=NODE_ENV=production
EnvironmentFile=/opt/agego/api/.env
ExecStart=/usr/bin/node src/server.js
Restart=always
RestartSec=5
User=agego
Group=agego

[Install]
WantedBy=multi-user.target
